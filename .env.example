# ═══════════════════════════════════════════════════════
# AlphaRadar 환경변수 템플릿
# 실제 사용: 이 파일을 .env 로 복사 후 값 채우기
#   cp .env.example .env
#   vim .env
# .env는 .gitignore에 등록되어 커밋되지 않습니다.
# ═══════════════════════════════════════════════════════

# ─── 한국투자증권 Open API ───────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_REAL=1                  # 1=실전, 0=모의

# ─── OpenDART (공시 정보) ───────────────────────────────
# https://opendart.fss.or.kr 에서 발급 (무료)
DART_API_KEY=

# ─── 네이버 Open API (DataLab 검색트렌드 + 뉴스 검색) ──
# https://developers.naver.com 에서 발급
# 키 1만으로도 동작. 키 2~9 등록 시 한도 초과(429) 자동 회전.
# DataLab(1,000건/일·키)·검색(25,000건/일·키)은 키별로 한도 분리됨.
# 각 API는 독립적으로 회전 (DataLab 키1 한도 도달 시 검색은 키1 계속 사용).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_CLIENT_ID_2=
NAVER_CLIENT_SECRET_2=
NAVER_CLIENT_ID_3=
NAVER_CLIENT_SECRET_3=
# 추가 키가 더 있다면 _4, _5, ... _9까지 가능

# ─── 텔레그램 봇 ────────────────────────────────────────
# @BotFather 에서 봇 생성 후 발급
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── 디버그 (선택) ──────────────────────────────────────
# 특정 종목 KIS 응답을 로그에 덤프 (수급 데이터 검증용)
# KIS_DEBUG_TICKER=001820
