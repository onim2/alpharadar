# ═══════════════════════════════════════════════════════
# AlphaRadar 캐시 — 커밋할 것과 무시할 것 분리
# 중요: data/cache/, data/logs/ 디렉토리 자체는 무시 X.
#       부모 디렉토리가 ignore 되면 자식 파일은 ! 로도 unignore 불가.
# ═══════════════════════════════════════════════════════

# 일별 캐시 — 무시 (날짜별 생성, 크기 큼, GitHub Actions cache 로 보호)
data/cache/datalab_*.pkl
data/cache/news_*.pkl
data/cache/precompute_*.pkl
data/cache/news_titles_*.pkl
data/cache/news_items_*.pkl
data/cache/dart_titles_*.pkl
data/cache/universe_*.pkl
data/cache/pool_a_*.pkl
data/cache/results_*.pkl
data/cache/kis_investor_*.pkl

# 임시 파일
data/cache/*.pkl.tmp

# 로그 — 오래된/압축된 것만 무시
data/logs/*.log.old
data/logs/*.gz

