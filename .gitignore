# ═══════════════════════════════════════════════════════
# 🔐 보안 — 절대 커밋하면 안 되는 파일
# ═══════════════════════════════════════════════════════
.env
.env.*
!.env.example
.kis_token
*.token
secrets.yaml

# ═══════════════════════════════════════════════════════
# Python 캐시
# ═══════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# ═══════════════════════════════════════════════════════
# 가상환경
# ═══════════════════════════════════════════════════════
venv/
env/
.venv/
ENV/

# ═══════════════════════════════════════════════════════
# OS
# ═══════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini

# ═══════════════════════════════════════════════════════
# IDE
# ═══════════════════════════════════════════════════════
.vscode/
.idea/
*.swp
*.swo

# ═══════════════════════════════════════════════════════
# 백업 파일
# ═══════════════════════════════════════════════════════
*.bak
*.bak_*
*.backup
*.orig
*~

# ═══════════════════════════════════════════════════════
# AlphaRadar 캐시 — 일부는 커밋 (성능 위해)
# ═══════════════════════════════════════════════════════

# DataLab 일별 호출 결과 등 큰 캐시는 제외
data/cache/datalab_*.pkl
data/cache/news_*.pkl
data/cache/precompute_*.pkl

# DART 섹터맵은 커밋 유지 (월 1회 갱신, 838개 한글 매핑 재생성 비용 큼)
# → !data/cache/dart_sector_map*.pkl 로 명시적 허용 (아래 참고)

# 로그 — 최근 것만 커밋, 오래된 것 제외
data/logs/*.log.old
data/logs/*.gz

# ═══════════════════════════════════════════════════════
# 명시적 커밋 허용 (위 패턴에 우연히 걸리는 것 예외)
# ═══════════════════════════════════════════════════════
!data/cache/dart_sector_map.pkl
!data/cache/dart_sector_map_v2.pkl
!data/scores_history.db
!data/logs/scanner_*.log

# 로컬 캐시·로그·DB (각 환경에서 자동 생성)
data/cache/
data/logs/
data/scores_history.db
*.log
*.pkl
